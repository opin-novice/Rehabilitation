\@writefile{lot}{\contentsline {table}{\numberline {III}{\ignorespaces Subject-clustered AUROC significance. Because each target corpus has only ten subjects, we bootstrap over subject clusters ($2{,}000$ resamples) with each score's orientation fixed once on the full sample. ``$>$chance?'' flags whether the $95\%$ subject CI excludes $0.50$. ``naive$-$model'' is the paired AUROC difference (naive minus that model) with its two-sided bootstrap $p$. No learned model is distinguishable from chance on REHAB246, and the naive baseline's advantage over the learned models is largely not significant.}}{5}{table.3}\protected@file@percent }
\newlabel{tab:auroc-sig}{{III}{5}{Subject-clustered AUROC significance. Because each target corpus has only ten subjects, we bootstrap over subject clusters ($2{,}000$ resamples) with each score's orientation fixed once on the full sample. ``$>$chance?'' flags whether the $95\%$ subject CI excludes $0.50$. ``naive$-$model'' is the paired AUROC difference (naive minus that model) with its two-sided bootstrap $p$. No learned model is distinguishable from chance on REHAB246, and the naive baseline's advantage over the learned models is largely not significant}{table.3}{}}
\@writefile{lot}{\contentsline {table}{\numberline {IV}{\ignorespaces Naive-baseline sensitivity to joint padding and normalization (zero-shot AUROC). ``Shared joints'' drops zero-padded (UI-PRMD) and duplicated (REHAB246) joints; ``z-scored'' recomputes features on per-sequence normalized coordinates.}}{5}{table.4}\protected@file@percent }
\newlabel{tab:naive-sens}{{IV}{5}{Naive-baseline sensitivity to joint padding and normalization (zero-shot AUROC). ``Shared joints'' drops zero-padded (UI-PRMD) and duplicated (REHAB246) joints; ``z-scored'' recomputes features on per-sequence normalized coordinates}{table.4}{}}
