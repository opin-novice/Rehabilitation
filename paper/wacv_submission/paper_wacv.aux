\def\@LN@column{1}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Clean-data accuracy (pooled, subject-disjoint, mean$\pm $std over 3 seeds). Every pairwise gap is inside the $0.33$~MAD \emph  {fixed-configuration} floor (seed-to-seed std $0.48$; the wider seed-variation table is in the supplement). $\Delta $ vs.\ floor is the SAME paired subject-cluster bootstrap statistic used in \cref  {tab:protocol3seed} ($n{=}77$ held-out subjects, pooled over 3 seeds $\times $ 5 folds, checkpoints re-evaluated with no retraining --- see \texttt  {pooled\_bootstrap\_eval.py}): every model's interval is entirely below $0$, so the tie \emph  {among} models coexists with each one genuinely beating the floor.}}{4}{table.caption.3}\protected@file@percent }
\newlabel{tab:accuracy}{{3}{4}{Clean-data accuracy (pooled, subject-disjoint, mean$\pm $std over 3 seeds). Every pairwise gap is inside the $0.33$~MAD \emph {fixed-configuration} floor (seed-to-seed std $0.48$; the wider seed-variation table is in the supplement). $\Delta $ vs.\ floor is the SAME paired subject-cluster bootstrap statistic used in \cref {tab:protocol3seed} ($n{=}77$ held-out subjects, pooled over 3 seeds $\times $ 5 folds, checkpoints re-evaluated with no retraining --- see \texttt {pooled\_bootstrap\_eval.py}): every model's interval is entirely below $0$, so the tie \emph {among} models coexists with each one genuinely beating the floor}{table.caption.3}{}}
\newlabel{tab:accuracy@cref}{{[table][3][]3}{[1][4][]4}{}{}{}}
